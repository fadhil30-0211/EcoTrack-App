<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray5">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/history_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/history_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Riwayat Laporan"
                android:textColor="@color/gray1"
                android:textSize="18sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_notifications_ios"
                app:tint="@color/gray2" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lapor_button"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Semua"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/filter_pending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_menu_icon"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Menunggu"
                    android:textColor="@color/gray3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/filter_processing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_menu_icon"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Diproses"
                    android:textColor="@color/gray3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/filter_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_menu_icon"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Selesai"
                    android:textColor="@color/gray3"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Content Section -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/history_header_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <include layout="@layout/item_history" />
            <include layout="@layout/item_history" />
            <include layout="@layout/item_history" />
            <include layout="@layout/item_history" />
            <include layout="@layout/item_history" />
            <include layout="@layout/item_history" />

            <!-- Spacing for bottom nav -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>