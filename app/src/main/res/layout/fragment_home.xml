<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <View
            android:id="@+id/home_header_bg"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_login_header"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/header_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Selamat Pagi, Fadhil! 👋"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sabtu, 16 Mei 2026 · Pekanbaru"
                        android:textColor="#BFFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_profile_header"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_logo_splash"
                    android:backgroundTint="#40FFFFFF"
                    android:padding="8dp"
                    android:src="@drawable/ic_person_ios" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ecopoint_bar"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_star_ios" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EcoPoint Kamu"
                        android:textColor="#BFFFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="1.250 poin"
                        android:textColor="@color/white"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+50 poin minggu ini"
                        android:textColor="#99FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_tukar_poin"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/acc2"
                    android:text="Tukar"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:background="@drawable/bg_content_top_rounded"
            android:backgroundTint="@color/gray5"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/header_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Menu Utama"
                android:textColor="@color/gray1"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black" />

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <include android:id="@+id/menu_map" layout="@layout/item_menu_home" />
                <include android:id="@+id/menu_report" layout="@layout/item_menu_home" />
                <include android:id="@+id/menu_schedule" layout="@layout/item_menu_home" />
                <include android:id="@+id/menu_recycle" layout="@layout/item_menu_home" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <include android:id="@+id/menu_guide" layout="@layout/item_menu_home" />
                <include android:id="@+id/menu_reward" layout="@layout/item_menu_home" />
                <include android:id="@+id/menu_stats" layout="@layout/item_menu_home" />
                <include android:id="@+id/menu_notif" layout="@layout/item_menu_home" />
            </LinearLayout>

            <!-- Row 3 (Additional Menus) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <include android:id="@+id/menu_history" layout="@layout/item_menu_home" />
                <include android:id="@+id/menu_bank" layout="@layout/item_menu_home" />
                <include android:id="@+id/menu_community" layout="@layout/item_menu_home" />
                <include android:id="@+id/menu_help" layout="@layout/item_menu_home" />
            </LinearLayout>

            <!-- Alert Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_alert_card"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_shipping_ios" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jadwal Pengangkutan Besok!"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Senin, 18 Mei · Pukul 07.00 WIB\nSiapkan sampah di depan rumah"
                        android:textColor="#D9FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Laporan Terbaru"
                    android:textColor="@color/gray1"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tv_view_all_reports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Lihat semua"
                    android:textColor="@color/g2"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Report List Placeholders -->
            <include layout="@layout/item_report_dashboard" />
            <include layout="@layout/item_report_dashboard" />
            <include layout="@layout/item_report_dashboard" />

            <!-- Spacing for bottom nav -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>