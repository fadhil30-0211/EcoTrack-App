<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:layout_weight="1"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/iv_reward_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_gift"
            app:tint="@color/acc" />

        <TextView
            android:id="@+id/tv_reward_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:text="Voucher Kopi"
            android:textColor="@color/gray1"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_gift"
                app:tint="@color/acc" />
            <TextView
                android:id="@+id/tv_reward_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="500 poin"
                android:textColor="@color/acc"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_redeem"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/accl"
            android:padding="0dp"
            android:text="Tukar"
            android:textAllCaps="false"
            android:textColor="@color/acc"
            android:textSize="11sp"
            android:fontFamily="sans-serif-black"
            app:cornerRadius="8dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>