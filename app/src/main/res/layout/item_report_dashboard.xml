<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star_ios" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_report_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Titik Sampah Jl. Sudirman"
                android:textColor="@color/gray1"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tv_report_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dilaporkan 2 jam lalu"
                android:textColor="@color/gray3"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pending"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Menunggu"
            android:textColor="@color/acc"
            android:textSize="10sp"
            android:fontFamily="sans-serif-black" />

    </LinearLayout>
</androidx.cardview.widget.CardView>