<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/hi_icon_bg"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_menu_icon"
            android:backgroundTint="@color/g5"
            android:gravity="center">
            <ImageView
                android:id="@+id/iv_hi_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_recycle"
                app:tint="@color/g2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_hi_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setor Sampah Plastik"
                android:textColor="@color/gray1"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tv_hi_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bank Sampah Maju · Kemarin"
                android:textColor="@color/gray3"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hi_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="+50"
            android:textColor="@color/g2"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>